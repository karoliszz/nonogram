<Window x:Class="nonogram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nonogram"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="900">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition ></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <!--game initiation  -->
        <TextBlock Text="Choose game grid size height x width" Grid.ColumnSpan="3" Height="55" Width="668" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="36"/>

        <TextBlock Text="height" Grid.Row="1" Grid.Column="1" Height="20" Width="70"  Grid.ColumnSpan="3" HorizontalAlignment="Left"/>
        <TextBlock Text="width" Grid.Row="1" Grid.Column="1" Height="20" Width="70"  Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="80,0,0,0"/>
        <TextBox Name="textGameHeight" Grid.Row="2"  Height="20" Width="70"  Grid.Column="1" HorizontalAlignment="Left"/>
        <TextBox Name="textGameWidth" Grid.Row="2" Height="20" Width="70"  Grid.Column="1" HorizontalAlignment="Left" Margin="80,0,0,0"/>

        <Button Content="Start new game" Name="mainButton"  Grid.Row="1" Background="Beige" BorderThickness="1" Click="newGameButton_Click" Width="120" Height="30" Grid.Column="1" HorizontalAlignment="Left" Grid.RowSpan="2" Margin="160,0,0,0"/>
        <Button Content="Submit Solution" Name="submitButton"  Grid.Row="1" Background="Green" BorderThickness="1" Width="120" Height="30"  Click="submitButton_Click" Grid.Column="1" HorizontalAlignment="Right" Grid.RowSpan="2"/>

        <!--game started  -->
        <Grid Name="GameGrid"  Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center">
            
        </Grid>
        

    </Grid>
</Window>
